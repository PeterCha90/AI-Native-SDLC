{
  "name": "ai-sdlc-runner",
  "version": "0.4.4",
  "description": "Linear 티켓을 6단계 AI-native SDLC 파이프라인(claude -p)으로 돌리고, 단계별 승인을 Slack 봇으로 받는 러너. npx ai-sdlc-runner init 으로 설정한다.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterCha90/AI-Native-SDLC.git",
    "directory": "AI_SDLC/runner"
  },
  "bin": {
    "ai-sdlc-runner": "dist/cli.js",
    "ai-sdlc": "dist/cli.js"
  },
  "files": [
    "dist",
    "plugin",
    "slack/manifest.yaml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && node scripts/prepare-package.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@slack/bolt": "^5.1.0"
  },
  "homepage": "https://github.com/PeterCha90/AI-Native-SDLC/tree/main/AI_SDLC/runner#readme",
  "keywords": [
    "claude",
    "claude-code",
    "sdlc",
    "ai-native",
    "slack-bot",
    "linear",
    "agent",
    "pipeline"
  ],
  "bugs": {
    "url": "https://github.com/PeterCha90/AI-Native-SDLC/issues"
  }
}

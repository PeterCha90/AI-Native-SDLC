{
  "name": "ai-sdlc-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Local runner that turns a Linear ticket into a 6-stage AI-SDLC pipeline of headless `claude -p` sessions.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0"
  }
}

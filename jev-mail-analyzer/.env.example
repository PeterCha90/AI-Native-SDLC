# TypeSafe AI (https://console.typesafe.ai/keys)
TYPESAFE_AI_API_KEY=sk-...

# Optional: override the JEV model. Defaults to jev-latest.
# TYPESAFE_MODEL=jev-latest

# Gmail is read server-side through an existing OAuth credential file
# (the JSON google-auth writes: token / refresh_token / client_id / client_secret).
# Defaults to the workspace-mcp credential for the address below.
# GOOGLE_ACCOUNT_EMAIL=you@gmail.com
# GOOGLE_CREDENTIALS_PATH=/absolute/path/to/credentials/you@gmail.com.json
